{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealseek-link-shortener",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "link.oli.boo", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": { "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dealseek-links",
      "database_id": "aef7f39c-5ec4-4102-bab8-7facc04ca6fc",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "LINK_CACHE", "id": "454ed23974604326abb36c8136e5ef44" }],
  "durable_objects": {
    "bindings": [
      { "name": "LINK_STATS", "class_name": "LinkStats", "script_name": "dealseek-link-stats" },
      { "name": "CREATE_LIMITER", "class_name": "CreateLimiter", "script_name": "dealseek-link-guard" }
    ]
  },
  "secrets": { "required": ["VISITOR_SALT"] },
  "ratelimits": [{ "name": "LOOKUP_LIMITER", "namespace_id": "70401", "simple": { "limit": 30, "period": 60 } }],
  "env": {
    "preview": {
      "name": "dealseek-link-shortener-preview",
      "routes": [],
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dealseek-links-preview",
          "database_id": "2b4c4e72-efd6-4a65-8625-11595e3b9c3c",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "LINK_CACHE", "id": "5010d48ab52d4a0aa6d5b6a540544f70" }],
      "durable_objects": {
        "bindings": [
          { "name": "LINK_STATS", "class_name": "LinkStats", "script_name": "dealseek-link-stats-preview" },
          { "name": "CREATE_LIMITER", "class_name": "CreateLimiter", "script_name": "dealseek-link-guard-preview" }
        ]
      },
      "secrets": { "required": ["VISITOR_SALT"] },
      "ratelimits": [{ "name": "LOOKUP_LIMITER", "namespace_id": "70402", "simple": { "limit": 30, "period": 60 } }]
    }
  }
}
