{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dealseek-link-guard",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "CREATE_LIMITER", "class_name": "CreateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CreateLimiter"] }],
  "env": {
    "preview": {
      "name": "dealseek-link-guard-preview",
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": { "bindings": [{ "name": "CREATE_LIMITER", "class_name": "CreateLimiter" }] }
    }
  }
}
